{
  "task": "NutAssemblySquare", "dataset": "Square PH low_dim_v15",
  "source_path": "data/raw/square_ph_low_dim_v15.hdf5",
  "split_seed": 20261022, "contamination_seed": 731902,
  "anchor_episodes": 8, "lag_test_episodes": 16,
  "preserve_official_validation": true,
  "corruption_fraction": 0.5,
  "mixed_deltas": [-1, 1, -2, 2, -4, 4], "large_deltas": [-4, 4],
  "max_shift": 4,
  "definition": "corrupted_action[t] = clean_action[t + delta]",
  "obs_keys": ["object", "robot0_eef_pos", "robot0_eef_quat", "robot0_gripper_qpos"],
  "object_slice": [7, 14], "obs_dim": 16,
  "observation_selection_reason": "raw absolute object pose plus proprioception; exclude cache-dependent relative object fields before training, without changing any selected value",
  "horizon": 16, "n_obs_steps": 2, "n_action_steps": 8, "n_latency_steps": 0,
  "pad_before": 0, "pad_after": 0, "oa_step_convention": true,
  "model": {"down_dims": [128, 256, 512], "diffusion_step_embed_dim": 128, "kernel_size": 5, "n_groups": 8, "cond_predict_scale": true},
  "scheduler": {"num_train_timesteps": 100, "beta_schedule": "squaredcos_cap_v2", "prediction_type": "epsilon", "inference": "DDIM", "num_inference_steps": 16, "eta": 0.0, "clip_sample": true},
  "normalization": "actions identity (already normalized OSC commands, official DP relative-action convention); obs shared clean training common-window per-coordinate limits [-1,1]; constant dimensions identity",
  "train_seeds": [42, 43], "updates": 50000, "batch_size": 256,
  "optimizer": {"lr": 0.0001, "betas": [0.95, 0.999], "eps": 1e-8, "weight_decay": 1e-6},
  "lr_scheduler": "cosine", "warmup_updates": 500,
  "ema": {"power": 0.75, "inv_gamma": 1.0, "max_value": 0.9999},
  "validation_every": 1000, "validation_batches": 20,
  "selection": "fixed final EMA; no rollout-based checkpoint selection or hyperparameter changes",
  "eval_seeds": {"start": 100000, "count": 50}, "eval_max_steps": 400,
  "eval_success": "ever env.is_success()['task'] during 400 normal control steps; record first hit and run full horizon",
  "eval_parallel_envs": 1, "torch_cpu_threads": 2,
  "clean_gate": {"near_failure_successes_at_most": 5, "ceiling_successes_at_least": 48, "required_episodes": 50},
  "step_d_gate": {"min_drop_percentage_points_each_seed": 10, "direction_consistent_both_seeds": true, "paired_bootstrap_95ci_lower_greater_than_zero": true},
  "bootstrap_seed": 9012, "bootstrap_replicates": 10000,
  "max_policy_trainings": 6
}
