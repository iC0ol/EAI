+def one_shot_release(renderer,action,api):
+    """Common outer guard: never suppress the first action or retry a failure."""
+    try:
+        state=getattr(renderer,'_controlled_release_state','NEW')
+        if state in ('DONE','RUNNING'):
+            api.note('one_shot_skip_'+state,renderer_tag=getattr(renderer,'_fixture_tag',None));return False
+        if state=='ERROR':raise RuntimeError('one-shot action already failed')
+        renderer._controlled_release_state='RUNNING'
+        api.note('one_shot_first_enter',renderer_tag=getattr(renderer,'_fixture_tag',None))
+        action(renderer)
+        renderer._controlled_release_state='DONE'
+        api.note('one_shot_first_done',renderer_tag=getattr(renderer,'_fixture_tag',None))
+        return True
+    except BaseException as exc:
+        renderer._controlled_release_state='ERROR';api.failure('one_shot_action',type(exc).__name__);raise
