    {
      "id": "H_reset",
      "hypothesis": "Extra outer reset changes controller/model/cache initialization and source replay",
      "test": "P1 vs archived P0 with same state seed and expert actions; do not infer root cause from code alone"
    },
    {
      "id": "H_cache",
      "hypothesis": "Offline forced-state observations and native online observable sampling differ",
      "test": "P2 native vs forced refresh vs qpos-derived clone at identical physical state; record any cache/physical side effects"
    },
    {
      "id": "H_controller",
      "hypothesis": "Controller or gripper internal initialization affects contact entry",
      "test": "Capture goals/ref/update flags/gripper action at reset boundaries and each substep; source internals absent, so causal proof limited"
    },
    {
      "id": "H_contact",
      "hypothesis": "Small physical differences amplify near nut/finger contact",
      "test": "Separate qpos/qvel/angles, new contact normals/forces/substeps/warmstart around t38..52; contact coincidence is not causal proof"
    },
    {
      "id": "H_runtime",
      "hypothesis": "Unrecorded collection runtime/integrator state prevents exact reconstruction",
      "test": "Audit metadata/XML/pinned runtime. Missing collection MuJoCo version and warmstart cannot be recovered from flattened states"
    }
  ],
